{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "removeComments": true,
    "declaration": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "outDir": "lib",
    "lib": ["ESNext"],
    "target": "ES5"
  },
  "include": ["src/*.ts"],
  "exclude": ["node_modules", "test"]
}
